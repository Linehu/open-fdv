[configuration]

; This file is the source of truth for the descriptor. build.bat copies it to
; game/ and to output/godot/ on every build, so editing those copies is a dead
; end -- the next build overwrites them.

entry_symbol = "library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/libfdv.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libfdv.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libfdv.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libfdv.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libfdv.macos.template_debug.framework"
macos.release = "res://bin/libfdv.macos.template_release.framework"
